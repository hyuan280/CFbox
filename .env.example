# Copy to .env and change values before exposing the service.
CFBOX_PORT=8000
CFBOX_API_KEY=
CFBOX_THREADS=8
CFBOX_CONF_WIDGET=0.25
CFBOX_CONF_STATE=0.25
CFBOX_CONFLICT_MARGIN=0.15
CFBOX_IOU=0.7
CFBOX_MAX_UPLOAD_MB=10
CFBOX_MAX_PIXELS=50000000
CFBOX_IDLE_UNLOAD_SECONDS=300
CFBOX_LOAD_ON_STARTUP=true
CFBOX_LOG_LEVEL=INFO
